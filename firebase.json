{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "FarmUp Autonomous Agriculture Platform",
        "supportEmail": "kisan@farmup-84a97.firebaseapp.com",
        "authorizedRedirectUris": [
          "https://farmup-84a97.firebaseapp.com/__/auth/handler",
          "https://farmup-84a97.web.app/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  }
}
